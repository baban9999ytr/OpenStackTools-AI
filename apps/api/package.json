{
  "name": "@openstacktools/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "migrate:budgets": "tsx src/scripts/migrate-pilot-budgets.ts",
    "demo:seed": "tsx src/scripts/seed-demo.ts",
    "telegram:bind": "tsx src/scripts/bind-telegram.ts",
    "telegram:webhook": "tsx src/scripts/configure-telegram-webhook.ts",
    "test:openai:live": "tsx test/live-openai.ts",
    "test:smtp:live": "tsx test/live-smtp.ts",
    "test:backup:restore": "tsx test/backup-restore.ts",
    "eval:deterministic": "tsx evals/deterministic.ts",
    "eval:live": "tsx evals/benchmark.ts --live",
    "eval:benchmark": "tsx evals/benchmark.ts",
    "eval:typecheck": "tsc -p evals/tsconfig.json"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "nodemailer": "^10.3.1",
    "openai": "^7.50.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.12",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.0.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
