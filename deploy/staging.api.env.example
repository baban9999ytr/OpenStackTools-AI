# Copy to staging.api.env (ignored by Git). Replace every placeholder.
NODE_ENV=production
PORT=5000
MONGODB_URL=mongodb://replace-user:replace-password@replace-private-host:27017/ost_ai_staging?replicaSet=replace-set&authSource=admin&tls=true
DASHBOARD_ORIGIN=https://replace-staging-host.example.invalid
SESSION_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
OPENAI_API_KEY=replace-with-a-dedicated-staging-project-key
OPENAI_MODEL=replace-with-a-supported-chat-model
OPENAI_MAX_COMPLETION_TOKENS=800
COOKIE_SECURE=true
TRUST_PROXY=1
DEFAULT_DAILY_BUDGET_USD=replace-with-a-small-staging-limit
DEFAULT_MONTHLY_BUDGET_USD=replace-with-a-small-staging-limit
OPENAI_INPUT_USD_PER_MILLION_TOKENS=replace-with-verified-model-price
OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=replace-with-verified-model-price
SMTP_HOST=replace-sandbox-smtp-host.example.invalid
SMTP_PORT=587
SMTP_REQUIRE_TLS=true
SMTP_FROM=OpenStackTools AI Staging <no-reply@example.invalid>
# SMTP_USER=replace-with-sandbox-user
# SMTP_PASSWORD=replace-with-sandbox-password
