NODE_ENV=development
PORT=5000
MONGODB_URL=mongodb://127.0.0.1:27017/openstacktools_ai
DASHBOARD_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
OPENAI_API_KEY=replace-with-a-server-side-api-key
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_COMPLETION_TOKENS=800
# Operator-reviewed tenant choices. Add Terra/Sol only after project access and pricing are verified.
AI_ENABLED_MODELS=gpt-6-luna
AI_MAX_REASONING_EFFORT=medium
# Optional ceiling for the full estimated Automatic request, including synthesis.
# AI_AUTOMATIC_MAX_REQUEST_USD=0.05
# Local business-day periods used for natural-language appointment requests.
APPOINTMENT_MORNING_WINDOW=09:00-12:00
APPOINTMENT_AFTERNOON_WINDOW=12:00-17:00
APPOINTMENT_EVENING_WINDOW=17:00-21:00
COOKIE_SECURE=false
TRUST_PROXY=0
DEFAULT_DAILY_BUDGET_USD=replace-with-your-pilot-daily-limit
DEFAULT_MONTHLY_BUDGET_USD=replace-with-your-pilot-monthly-limit
OPENAI_INPUT_USD_PER_MILLION_TOKENS=0.10
OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=0.50
OPENAI_CACHED_INPUT_USD_PER_MILLION_TOKENS=0.01
OPENAI_CACHE_WRITE_USD_PER_MILLION_TOKENS=0.125
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_REQUIRE_TLS=false
SMTP_FROM=OpenStackTools AI <no-reply@example.invalid>
# SMTP_USER=replace-with-smtp-user-if-needed
# SMTP_PASSWORD=replace-with-smtp-password-if-needed
# Optional Telegram connection secrets; suffixes must match the binding command.
# OST_TELEGRAM_BOT_TOKEN_PILOT=replace-with-a-bot-token-in-a-private-environment
# OST_TELEGRAM_WEBHOOK_SECRET_PILOT=replace-with-a-random-telegram-compatible-secret
# Self-service Telegram onboarding is disabled until the operator configures these.
TELEGRAM_SELF_SERVICE_ENABLED=false
# TELEGRAM_PUBLIC_API_ORIGIN=https://api.example.invalid
# CHANNEL_CREDENTIAL_ACTIVE_KEY_ID=V1
# CHANNEL_CREDENTIAL_KEY_V1=replace-with-a-random-32-byte-base64-key

# New product modes fail closed until the operator verifies project entitlement,
# Responses function calling, standard text pricing and account region.
# Comma-separated verified IDs; this is NOT an access grant or a provider probe.
# Keep empty until verified. AI_ENABLED_MODELS and organization policy also apply.
AI_VERIFIED_MODELS=
