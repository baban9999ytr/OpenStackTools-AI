{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "OpenStackTools AI",
  "version": "1.0.0",
  "source": "OpenStackTools zinc/sky visual identity; independently maintained AI token contract",
  "font": {
    "sans": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "mono": "JetBrains Mono, ui-monospace, SFMono-Regular, monospace"
  },
  "radius": { "sm": "4px", "md": "8px", "lg": "12px" },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px" },
  "theme": {
    "light": {
      "page": "#ffffff",
      "surface": "#ffffff",
      "surfaceSoft": "#f4f4f5",
      "text": "#18181b",
      "muted": "#52525b",
      "border": "#d4d4d8",
      "accent": "#0369a1",
      "accentHover": "#075985",
      "accentSubtle": "#e0f2fe",
      "accentText": "#ffffff",
      "danger": "#b91c1c",
      "dangerSubtle": "#fef2f2",
      "success": "#166534",
      "successSubtle": "#f0fdf4",
      "focus": "#0284c7"
    },
    "dark": {
      "page": "#09090b",
      "surface": "#18181b",
      "surfaceSoft": "#27272a",
      "text": "#f4f4f5",
      "muted": "#a1a1aa",
      "border": "#3f3f46",
      "accent": "#7dd3fc",
      "accentHover": "#bae6fd",
      "accentSubtle": "#082f49",
      "accentText": "#082f49",
      "danger": "#fca5a5",
      "dangerSubtle": "#450a0a",
      "success": "#86efac",
      "successSubtle": "#052e16",
      "focus": "#7dd3fc"
    }
  }
}
